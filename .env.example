# =====================================================================
# Opção 1: CNPJ.ws Comercial (Recomendado - 100% nativo do projeto)
# Obtenha seu token em https://www.cnpj.ws
# Carrega automaticamente todas as Inscrições Estaduais (Sintegra/CCC)
# =====================================================================
VITE_CNPJ_WS_TOKEN=

# =====================================================================
# Opção 2: SintegraWS (Especializada em Sintegra/CCC)
# Obtenha seu token em https://www.sintegraws.com.br
# =====================================================================
VITE_SINTEGRA_WS_TOKEN=

# =====================================================================
# Opção 3: Nuvem Fiscal (OAuth 2.0)
# =====================================================================
VITE_NUVEM_FISCAL_CLIENT_ID=
VITE_NUVEM_FISCAL_CLIENT_SECRET=
VITE_NUVEM_FISCAL_USE_SANDBOX=false
